{
  "resource": "wallet_transactions",
  "roots": ["prepared", "exported"],
  "states": ["prepared", "exported", "submission_unknown", "submitted", "observed", "confirmed", "rejected", "conflicted", "expired", "abandoned"],
  "terminal": ["confirmed", "rejected", "conflicted"],
  "quiescent": ["expired", "abandoned"],
  "nonterminal": ["prepared", "exported", "submission_unknown", "submitted", "observed"],
  "notes": {
    "quiescent": "terminal modulo a bounded trailing watch — late evidence revives to observed/confirmed",
    "abandoned": "absence verdict (no competing spend) — distinct from conflicted; fires txDied and keeps the trailing watch",
    "rejected": "provisional — a refused tx can still be aired by a counterparty holding the signed bytes; verified/proof revive it and re-run custody (tx-spent) + retro-count the spend (record-aired)",
    "conflicted": "provisional like rejected — obs.conflicted needs only a verified spentBy report, and a later BUMP for OUR tx beats it: obs.proven heals back to confirmed (the healLedgerOnProof path)",
    "event-source guards": "obs.proven is the ONLY event that may emit 'confirmed'; obs.* require verified observations — status words and hints may only feed 'hint' handling, never a verdict transition"
  },
  "transitions": [
    { "state": "prepared", "event": "submit", "guard": "leases-held", "intents": ["broadcast"], "target": "prepared" },
    { "state": "prepared", "event": "submit.success", "intents": ["release-leases", "tx-spent", "watch"], "target": "submitted" },
    { "state": "prepared", "event": "submit.refused", "guard": "definitive", "intents": ["release-leases", "tx-died"], "target": "rejected" },
    { "state": "prepared", "event": "submit.unknown", "intents": ["watch"], "target": "submission_unknown" },
    { "state": "prepared", "event": "obs.rejected", "guard": "verified", "intents": ["release-leases", "tx-died"], "target": "rejected" },
    { "state": "prepared", "event": "resubmit", "intents": ["broadcast"], "target": "prepared" },

    { "state": "submission_unknown", "event": "submit", "intents": ["broadcast"], "target": "submission_unknown" },
    { "state": "submission_unknown", "event": "resubmit", "intents": ["broadcast"], "target": "submission_unknown" },
    { "state": "submission_unknown", "event": "submit.success", "intents": ["release-leases", "tx-spent", "watch"], "target": "submitted" },
    { "state": "submission_unknown", "event": "submit.refused", "guard": "definitive", "intents": ["release-leases", "tx-died"], "target": "rejected" },
    { "state": "submission_unknown", "event": "obs.seen", "guard": "verified", "intents": [], "target": "observed" },
    { "state": "submission_unknown", "event": "obs.proven", "guard": "proof", "intents": ["leases->spent"], "target": "confirmed" },
    { "state": "submission_unknown", "event": "obs.rejected", "guard": "verified", "intents": ["release-leases", "tx-died"], "target": "rejected" },
    { "state": "submission_unknown", "event": "obs.conflicted", "guard": "verified+spentBy", "intents": ["release-leases", "tx-died"], "target": "conflicted" },
    { "state": "submission_unknown", "event": "abandon", "intents": ["release-leases", "tx-died", "watch-trailing"], "target": "abandoned" },

    { "state": "submitted", "event": "resubmit", "intents": ["broadcast"], "target": "submitted" },
    { "state": "submitted", "event": "obs.seen", "guard": "verified", "intents": ["release-leases"], "target": "observed" },
    { "state": "submitted", "event": "obs.proven", "guard": "proof", "intents": ["leases->spent"], "target": "confirmed" },
    { "state": "submitted", "event": "obs.rejected", "guard": "verified", "intents": ["release-leases", "tx-died"], "target": "rejected" },
    { "state": "submitted", "event": "obs.conflicted", "guard": "verified+spentBy", "intents": ["release-leases", "tx-died"], "target": "conflicted" },
    { "state": "submitted", "event": "abandon", "intents": ["release-leases", "tx-died", "watch-trailing"], "target": "abandoned" },

    { "state": "observed", "event": "resubmit", "intents": ["broadcast"], "target": "observed" },
    { "state": "observed", "event": "obs.seen", "guard": "verified", "intents": [], "target": "observed" },
    { "state": "observed", "event": "obs.proven", "guard": "proof", "intents": ["leases->spent"], "target": "confirmed" },
    { "state": "observed", "event": "obs.rejected", "guard": "verified", "intents": ["release-leases", "tx-died"], "target": "rejected" },
    { "state": "observed", "event": "obs.conflicted", "guard": "verified+spentBy", "intents": ["release-leases", "tx-died"], "target": "conflicted" },
    { "state": "observed", "event": "abandon", "intents": ["release-leases", "tx-died", "watch-trailing"], "target": "abandoned" },

    { "state": "exported", "event": "obs.seen", "guard": "verified", "intents": ["release-leases"], "target": "observed" },
    { "state": "exported", "event": "obs.proven", "guard": "proof", "intents": ["leases->spent"], "target": "confirmed" },
    { "state": "exported", "event": "obs.rejected", "guard": "verified", "intents": ["release-leases", "tx-died"], "target": "rejected" },
    { "state": "exported", "event": "export.ttl", "intents": ["release-leases", "export-expired", "watch-trailing"], "target": "expired" },

    { "state": "rejected", "event": "obs.seen", "guard": "verified", "intents": ["tx-spent", "record-aired"], "target": "observed" },
    { "state": "rejected", "event": "obs.proven", "guard": "proof", "intents": ["tx-spent", "leases->spent", "record-aired"], "target": "confirmed" },

    { "state": "expired", "event": "obs.seen", "guard": "verified", "intents": ["tx-spent", "record-aired"], "target": "observed" },
    { "state": "expired", "event": "obs.proven", "guard": "proof", "intents": ["tx-spent", "leases->spent", "record-aired"], "target": "confirmed" },
    { "state": "expired", "event": "obs.conflicted", "guard": "verified+spentBy", "intents": [], "target": "conflicted" },
    { "state": "abandoned", "event": "obs.seen", "guard": "verified", "intents": ["tx-spent", "record-aired"], "target": "observed" },
    { "state": "abandoned", "event": "obs.proven", "guard": "proof", "intents": ["tx-spent", "leases->spent", "record-aired"], "target": "confirmed" },
    { "state": "abandoned", "event": "obs.conflicted", "guard": "verified+spentBy", "intents": [], "target": "conflicted" },

    { "state": "conflicted", "event": "obs.proven", "guard": "proof", "intents": ["tx-spent", "leases->spent", "record-aired"], "target": "confirmed" },

    { "state": "*", "event": "process.crash", "intents": ["boot-reconcile"], "target": "self" },
    { "state": "*", "event": "kill.switch", "intents": [], "target": "self" },
    { "state": "*", "event": "daily.cap", "intents": [], "target": "self" },
    { "state": "*", "event": "reorg", "intents": ["reverify"], "target": "self" }
  ]
}
