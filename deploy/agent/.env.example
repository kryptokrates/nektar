# Nektar v0.1 Agent — Environment Configuration
NEKTAR_NETWORK=testnet
NEKTAR_HTTP_BIND=127.0.0.1
NEKTAR_HTTP_PORT=18420
NEKTAR_PUBLIC_URL=
NEKTAR_VERIFY_BASE=
NEKTAR_DOMAIN=
NEKTAR_TRUST_PROXY=0

# Generate with: openssl rand -hex 32 (auto-generated on non-loopback/container boots if empty)
NEKTAR_HTTP_TOKEN=
NEKTAR_OPERATOR_TOKEN=

# Market & Adapter settings
NEKTAR_MARKET_HOSTS=
NEKTAR_SEED_DOMAINS=
NEKTAR_TOOL_PROFILE=operator
NEKTAR_TOOL_PRICES=
NEKTAR_WALLET=embedded
NEKTAR_OPENAI_UPSTREAM=https://api.openai.com
NEKTAR_ANTHROPIC_UPSTREAM=https://api.anthropic.com

# Chain & SpendGuard (leave NEKTAR_HEADERS_SOURCE empty to auto-select network defaults:
# woc:test on testnet; dual-witness woc:main + Babbage Chaintracks v2 on main)
NEKTAR_HEADERS_SOURCE=
NEKTAR_CHAIN_SPEC=
NEKTAR_SETTLE_SPEC=
NEKTAR_ARCADE_KEY=
NEKTAR_WOC_KEY=
# Restate durable executor (auto-wired in compose.yaml)
NEKTAR_RESTATE_URL=http://restate:8080
NEKTAR_RESTATE_ADMIN=http://restate:9070
NEKTAR_RESTATE_ENDPOINT_URI=http://agent:9080
NEKTAR_RESTATE_IDENTITY_KEY=
NEKTAR_RESTATE_INTERNAL_TOKEN=

# SpendGuard caps
NEKTAR_MAX_FEE_PER_TX=10000
NEKTAR_MAX_SPEND_PER_DAY=100000
NEKTAR_MAINNET_CONFIRM=
