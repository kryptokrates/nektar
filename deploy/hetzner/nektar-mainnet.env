# nektar.run — managed non-secret v0.1 Pure-Go MAINNET Spine Hub config for Hetzner.
#
# SECURITY: Never commit secrets or mainnet confirmation here!
# Place box-local secrets in /opt/nektar/.env.mainnet (chmod 600):
#   NEKTAR_MAINNET_CONFIRM=I_UNDERSTAND
#   NEKTAR_HTTP_TOKEN=<openssl rand -hex 32>
#   NEKTAR_OPERATOR_TOKEN=<openssl rand -hex 32>
#   NEKTAR_OPERATOR_PUBKEY=<02/03 66-hex cold operator pubkey>
#   NEKTAR_BACKUP_S3_BUCKET=<optional R2/S3/B2 bucket>
#   NEKTAR_BACKUP_S3_ENDPOINT=<optional https://<account>.r2.cloudflarestorage.com>
#   NEKTAR_BACKUP_S3_REGION=auto
#   NEKTAR_BACKUP_S3_PREFIX=nektar-mainnet-spine
#   NEKTAR_BACKUP_S3_ACCESS_KEY=<key>
#   NEKTAR_BACKUP_S3_SECRET_KEY=<secret>

NEKTAR_NETWORK=main
NEKTAR_EMBED_HUB=1
NEKTAR_PUBLIC_URL=https://nektar.run
NEKTAR_TRUST_PROXY=1
NEKTAR_HTTP_BIND=127.0.0.1
NEKTAR_HTTP_PORT=18422

# Backbone Spine Hub role, BRC-149 relay transport & hybrid BRC-105 HTTP 402 anti-freerider metering
NEKTAR_HUB_ROLE=spine
NEKTAR_HUB_TRANSPORT=relay
NEKTAR_HUB_FEE_PRESET=hybrid

# 2-of-3 independent non-circular PoW header witnesses (WhatsOnChain + US/EU BSV Association Arcade v2)
# + US/EU official BSV Association BSV Broadcaster failover (zero GorillaPool, zero Babbage)
NEKTAR_HEADERS_SOURCE=woc:main,arcade:https://arcade-v2-us-1.bsvblockchain.tech,arcade:https://arcade-eu-1.bsvblockchain.tech
NEKTAR_SETTLE_SPEC=broadcaster:main
NEKTAR_SETTLE_DEPTH=6
NEKTAR_WALLET_PROFILE=standard

# Require pinned Restate v1.8.1 durable execution plane on Mainnet
NEKTAR_RESTATE_REQUIRED=1

# Conservative Mainnet canary SpendGuard ceilings (bump only after soak + canary verification)
NEKTAR_MAX_FEE_PER_TX=2000
NEKTAR_MAX_SPEND_PER_DAY=10000
NEKTAR_FAUCET_DAILY_CAP=0

# Autonomy: live SNTP clock-skew guard + BRC-42 encrypted WAL-safe snapshots
NEKTAR_NTP_SERVERS=time.cloudflare.com,time.google.com,pool.ntp.org
NEKTAR_BACKUP_DIR=/backups
NEKTAR_BACKUP_INTERVAL=6h
NEKTAR_BACKUP_KEEP=14
