# nektar.run — managed non-secret v0.4 Pure-Go Spine Hub config for Hetzner.
# Box-local secrets (NEKTAR_HTTP_TOKEN, NEKTAR_OPERATOR_TOKEN, wallet keys) stay in /opt/nektar/.env only.

NEKTAR_NETWORK=testnet
NEKTAR_EMBED_HUB=1
NEKTAR_PUBLIC_URL=https://nektar.run
NEKTAR_TRUST_PROXY=1

# Backbone Spine Hub role & fee preset (free | lightbsv_egress | hybrid)
NEKTAR_HUB_ROLE=spine
NEKTAR_HUB_FEE_PRESET=hybrid

# Witnessed PoW headers & Arcade settlement
NEKTAR_HEADERS_SOURCE=woc:test
NEKTAR_SETTLE_SPEC=arcade:https://testnet.arcade.gorillapool.io

# SpendGuard ceilings
NEKTAR_MAX_FEE_PER_TX=2000
NEKTAR_MAX_SPEND_PER_DAY=200000
NEKTAR_FAUCET_DAILY_CAP=50000
