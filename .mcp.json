{
  "mcpServers": {
    "MCP_DOCKER": {
      "command": "docker",
      "args": ["mcp", "gateway", "run", "--profile", "nektar"],
      "env": { "LOCALAPPDATA": "C:\\Users\\\nedzo\\AppData\\Local", "ProgramData": "C:\\ProgramData", "ProgramFiles": "C:\\Program Files" },
      "type": "stdio"
    },
    "bsv-docs": {
      "type": "http",
