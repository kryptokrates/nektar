# nektar.run — managed keys for /etc/nektar-http.env on the Hetzner box.
#
# deploy.yml applies every KEY=value in this file to the box env on each
# deploy (update-or-append per key). Keys NOT listed here — secrets, tokens,
# WIFs, FUND_TXIDS, DATA_DIR, HTTP_PORT/HOST — stay box-local. Edit this
# file and push to reconfigure the instance.
#
# What the instance IS is therefore visible in git: currently a testnet
# market agent — a quorum participant with its own host pair at
# https://nektar.run/hosts/{a,b}.

NEKTAR_NETWORK=testnet
# automation is OFF until strict preflight can pass — it refuses to boot
# without: reachable hosts, an active policy for testnet+agent, ≥2000 sats
# reserve, and a conformance.token under NEKTAR_UNATTENDED. Flip to 1 once
# the provisioning in deploy/hetzner/README.md is done.
NEKTAR_AUTOMATION=

# the quorum this agent reads/publishes through — its own public host pair.
# Other operators' hosts can be appended (comma-separated); the agent unions
# configured hosts with its finger record's.
NEKTAR_MARKET_HOSTS=https://nektar.run/hosts/a,https://nektar.run/hosts/b

# long-poll wake layer — own watch shims on loopback (agents can also run
# without; polls are the correct-by-design fallback)
NEKTAR_WATCH_URLS=http://127.0.0.1:18293,http://127.0.0.1:18294

# public push endpoint — Caddy already fronts /v1/* → :8080
NEKTAR_PUSH_PUBLIC=https://nektar.run/v1/lane

# discoverable via bfinger so counterparties can resolve this agent's
# hosts/office/stream
NEKTAR_BFINGER_PUBLISH=1

# autonomous market participation — approvals auto-decide under SpendGuard
# caps below. Empty = queue approvals for the operator token instead.
NEKTAR_UNATTENDED=1

# SpendGuard caps for an unattended public box — hard ceilings, not targets
NEKTAR_MAX_FEE_SATS_PER_TX=2000
NEKTAR_MAX_SPEND_SATS_PER_DAY=200000
