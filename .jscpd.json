{
  "$schema": "https://json.schemastore.org/jscpd",
  "minLines": 8,
  "minTokens": 60,
  "maxLines": 800,
  "threshold": 5,
  "gitignore": true,
  "formatsExts": {
    "typescript": ["ts", "mts"],
    "javascript": ["js", "mjs"]
  },
  "ignore": [
    "**/dist/**",
    "**/node_modules/**",
    "**/coverage/**",
    "**/artifacts/**",
    "**/.mod/**",
    "**/.state/**",
    "**/.nektar*/**",
    "vendor/**",
    "dist-bundle/**",
    "packages/contracts/Nektar*.json",
    "packages/zk/stark/**",
    "infra/**",
    "spikes/**",
    "**/*.runar.ts",
    "**/*.d.ts",
    "**/*.test.ts",
    "**/test/**",
    "**/demo/**"
  ]
}
