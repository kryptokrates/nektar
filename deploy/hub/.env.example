# Nektar v0.4 Hub — Environment Configuration (Pure-Go + Spine-and-Leaf + Restate v1.8.1)
NEKTAR_NETWORK=testnet
NEKTAR_HTTP_BIND=127.0.0.1
NEKTAR_HTTP_PORT=18420
NEKTAR_DOMAIN=hub.example.com
NEKTAR_PUBLIC_URL=https://hub.example.com
NEKTAR_TRUST_PROXY=1

# Generate with: openssl rand -hex 32
NEKTAR_HTTP_TOKEN=
NEKTAR_OPERATOR_TOKEN=

# Spine-and-Leaf Topology & Monetization
#   role: leaf (edge hub forwarding UP to spines) | spine (backbone hub metering DOWN)
#   fee preset: free | lightbsv_egress | hybrid
NEKTAR_HUB_ROLE=leaf
NEKTAR_HUB_FEE_PRESET=free
NEKTAR_PEER_HUBS=https://nektar.run/hub
NEKTAR_UPSTREAM_SPINES=https://nektar.run/hub
NEKTAR_SPINE_PEER_PUBS=
NEKTAR_MARKET_HOSTS=
NEKTAR_SEED_DOMAINS=
NEKTAR_TOOL_PRICES=
NEKTAR_HUB_RESALE_SATS=120
NEKTAR_FAUCET_DAILY_CAP=50000

# Optional per-valve fee overrides (leave blank to use NEKTAR_HUB_FEE_PRESET defaults)
NEKTAR_HUB_SUBMIT_WANT_SATS=
NEKTAR_HUB_SUBMIT_OFFER_SATS=
NEKTAR_HUB_SUBMIT_ANNOUNCE_SATS=
NEKTAR_HUB_BBOX_SEND_SATS=
NEKTAR_HUB_EGRESS_SATS_PER_100=
NEKTAR_HUB_EGRESS_MIN_TOPUP_SATS=
NEKTAR_HUB_LOOKUP_PRICES=

# Chain & Witnessed PoW Headers (mainnet requires >=2 independent non-circular sources)
NEKTAR_HEADERS_SOURCE=woc:test
NEKTAR_SETTLE_SPEC=arcade:https://testnet.arcade.gorillapool.io
NEKTAR_ARCADE_KEY=
NEKTAR_WOC_KEY=

# Restate v1.8.1 durable executor (auto-wired in compose.yaml)
NEKTAR_RESTATE_URL=http://restate:8080
NEKTAR_RESTATE_ADMIN=http://restate:9070
NEKTAR_RESTATE_ENDPOINT_URI=http://hub:9080
NEKTAR_RESTATE_IDENTITY_KEY=
RESTATE_IDENTITY_PRIVATE_KEY_PEM_FILE=
NEKTAR_RESTATE_INTERNAL_TOKEN=

# SpendGuard caps & Mainnet gate
NEKTAR_MAX_FEE_PER_TX=10000
NEKTAR_MAX_SPEND_PER_DAY=100000
NEKTAR_MAINNET_CONFIRM=

# Optional Cloudflare Tunnel token (--profile tunnel-token)
CLOUDFLARE_TUNNEL_TOKEN=
