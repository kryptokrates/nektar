# Nektar v0.4 Hub — Environment Configuration
NEKTAR_NETWORK=testnet
NEKTAR_HTTP_BIND=127.0.0.1
NEKTAR_HTTP_PORT=18420
NEKTAR_DOMAIN=hub.example.com
NEKTAR_PUBLIC_URL=https://hub.example.com
NEKTAR_TRUST_PROXY=1

# Generate with: openssl rand -hex 32
NEKTAR_HTTP_TOKEN=
NEKTAR_OPERATOR_TOKEN=

# Optional federation & liquidity settings
NEKTAR_MARKET_HOSTS=
NEKTAR_PEER_HUBS=
NEKTAR_SEED_DOMAINS=
NEKTAR_TOOL_PRICES=
NEKTAR_HUB_RESALE_SATS=120
NEKTAR_FAUCET_DAILY_CAP=50000

# Chain & SpendGuard
NEKTAR_HEADERS_SOURCE=woc:test
NEKTAR_SETTLE_SPEC=
NEKTAR_ARCADE_KEY=
NEKTAR_WOC_KEY=
# Restate durable executor (auto-wired in compose.yaml)
NEKTAR_RESTATE_URL=http://restate:8080
NEKTAR_RESTATE_ADMIN=http://restate:9070
NEKTAR_RESTATE_ENDPOINT_URI=http://hub:9080
NEKTAR_RESTATE_IDENTITY_KEY=
# Optional path inside the restate container to a mounted Ed25519 Request Identity v1 PEM file
RESTATE_IDENTITY_PRIVATE_KEY_PEM_FILE=
NEKTAR_RESTATE_INTERNAL_TOKEN=

# SpendGuard caps
NEKTAR_MAX_FEE_PER_TX=10000
NEKTAR_MAX_SPEND_PER_DAY=100000
NEKTAR_MAINNET_CONFIRM=

# Optional Cloudflare Tunnel token (--profile tunnel-token)
CLOUDFLARE_TUNNEL_TOKEN=
