{
  "resource": "market_outbox",
  "roots": ["pending"],
  "states": ["pending", "deferred", "sent", "dead"],
  "terminal": ["sent", "dead"],
  "nonterminal": ["pending", "deferred"],
  "notes": {
    "deferred": "parked on a named class (funding-slot, cap-window, host-down, record-miss) — unblocks when the class clears, not on a timer alone",
    "dead": "attempts exhausted or canceled by a settled leg — a repair row's own settle cancels it",
    "guards": "defer carries the class as payload context; unblock requires the SAME class — a different class must not wake it"
  },
  "transitions": [
    { "state": "pending", "event": "deliver", "intents": [], "target": "sent" },
    { "state": "pending", "event": "fail", "guard": "attempts<max", "intents": [], "target": "self" },
    { "state": "pending", "event": "exhaust", "guard": "attempts>=max", "intents": [], "target": "dead" },
    { "state": "pending", "event": "defer", "intents": ["stamp-class"], "target": "deferred" },
    { "state": "pending", "event": "cancel", "intents": [], "target": "dead" },
    { "state": "deferred", "event": "unblock", "guard": "same-class", "intents": [], "target": "pending" },
    { "state": "deferred", "event": "cancel", "intents": [], "target": "dead" },
    { "state": "deferred", "event": "exhaust", "guard": "attempts>=max", "intents": [], "target": "dead" }
  ]
}
