# nektar.run — managed non-secret v0.1 Pure-Go Spine Hub config for Hetzner.
# Box-local secrets (NEKTAR_HTTP_TOKEN, NEKTAR_OPERATOR_TOKEN, wallet keys) stay in /opt/nektar/.env only.

NEKTAR_NETWORK=testnet
NEKTAR_EMBED_HUB=1
NEKTAR_PUBLIC_URL=https://nektar.run
NEKTAR_TRUST_PROXY=1

# Backbone Spine Hub role & fee preset (free | lightbsv_egress | hybrid)
NEKTAR_HUB_ROLE=spine
NEKTAR_HUB_FEE_PRESET=hybrid
NEKTAR_PEER_HUBS=https://nektar.run/hubs/1,https://nektar.run/hubs/2,https://nektar.run/hubs/3,https://nektar.run/hubs/4,https://nektar.run/hubs/5

# Witnessed PoW headers & official BSV Association BSV Broadcaster settlement (zero GorillaPool)
# Mainnet cutover: set NEKTAR_NETWORK=main, NEKTAR_HEADERS_SOURCE=woc:main,chaintracks:https://mainnet-chaintracks.babbage.systems/v2,
# NEKTAR_SETTLE_SPEC=broadcaster:main, and add NEKTAR_MAINNET_CONFIRM=I_UNDERSTAND in box-local /opt/nektar/.env.
NEKTAR_HEADERS_SOURCE=woc:test
NEKTAR_SETTLE_SPEC=broadcaster:testnet

# SpendGuard ceilings
NEKTAR_MAX_FEE_PER_TX=2000
NEKTAR_MAX_SPEND_PER_DAY=200000
NEKTAR_FAUCET_DAILY_CAP=50000
