# ── public TLS domain (built-in Caddy Auto-TLS via `--profile tls`) ─────────
# Set NEKTAR_DOMAIN=hub.example.com (or let install.sh derive <ip>.sslip.io).
NEKTAR_DOMAIN=
NEKTAR_PUBLIC_URL=

# ── secrets (auto-generated by install.sh; NEKTAR_* optional on testnet) ────
# encrypts keys.json at rest — generate: openssl rand -hex 32
NEKTAR_KEY_PASSPHRASE=

# bearer for /mcp + private /v1 endpoints — generate: openssl rand -hex 32
NEKTAR_HTTP_TOKEN=
# operator token for Dashboard approvals + /v1/hosts join
NEKTAR_OPERATOR_TOKEN=

# overlay internals — generate: openssl rand -hex 32 (both)
OVERLAY_DB_PASSWORD=
OVERLAY_ADMIN_TOKEN=

# your hosts' PUBLIC URLs — the hub's announce and finger record advertise
# these verbatim, so they must be what OTHER operators can reach, e.g.
#   https://hub.example/hosts/a,https://hub.example/hosts/b
# (a reverse proxy maps /hosts/a→:18391, /hosts/b→:18392). Include the seed
# hosts too so your hub reads the whole network, not just its own lanes:
#   ...your-pair...,https://nektar.run/hosts/a,https://nektar.run/hosts/b
NEKTAR_MARKET_HOSTS=

# ── discovery ───────────────────────────────────────────────────────────────
# publish the directory card (default on for a hub — discoverability is the
# point). The card carries your hosts + offered seed packs.
NEKTAR_ANNOUNCE=1
# publish your bfinger record so counterparties resolve your office/push
NEKTAR_BFINGER_PUBLISH=1
# seed packs at boot from announces matching these domains ('*' = all).
# Every imported record lands in your anchored log — on paid networks a
# seed pass carries a small share of the next anchor's cost, SpendGuard-
# gated like every spend. Defaults to '*' (import every announced pack);
# set EMPTY to keep a silo.
NEKTAR_SEED_DOMAINS=
# your public base URL peers POST pushed carriers to: https://hub.example
NEKTAR_PUSH_PUBLIC=
# your watch shims' public URLs (ports 18393/18394 → /watch/a, /watch/b)
NEKTAR_WATCH_URLS=
NEKTAR_WATCH_PUBLIC=

# ── funds & network ─────────────────────────────────────────────────────────
# optional — blank = the agent generates a persistent key (fee.key.json in the
# data volume) and prints `operator fee key <address>` at boot. Fund that
# address, then either set NEKTAR_FUND_TXIDS=<funding txid> and restart, or
# boot with NEKTAR_WAIT_FUNDING=1 to have it wait+detect. Set a WIF only to
# bring your own key (base58check — NOT raw hex).
NEKTAR_FUND_WIF=
# one funding txid (comma-sep for several) — credit a tx paying the fee
# address into the reserve without index discovery
NEKTAR_FUND_TXIDS=
# hold startup and watch the fee address until sats land (QR + hold; 30min cap)
NEKTAR_WAIT_FUNDING=
# let the agent discover UTXOs at the fee address via the public index
NEKTAR_INDEXER_DISCOVERY=
# testnet | main — one knob drives the agent, the hosts' served lanes and
# the overlay topics (they can never skew). main needs MAINNET_CONFIRM below
# AND the three SHIM_* endpoints — the testnet defaults don't serve main.
NEKTAR_NETWORK=testnet
# required when NEKTAR_NETWORK=main — the ack that real sats are at stake
NEKTAR_MAINNET_CONFIRM=
# chain endpoints the hosts' header shim proxies — testnet defaults baked in
# (arcade-v2 testnet + bananablocks). On main supply your own: self-hosted
# Teranode or an ARC-compatible broadcaster + index + chaintracks source.
SHIM_BROADCASTER=
SHIM_INDEX=
SHIM_CHAINTRACKS=
# strict two-source header verification is on by default — set 0 only to
# serve proofs from a single header source when the witness is down
NEKTAR_STRICT_HEADERS=
NEKTAR_HTTP_PORT=8080

# which lane kinds may serve anchored (unproven-but-ancestry-anchored)
# funding stock — 'all' lets a fresh agent deal before its trees mine.
# Only valid against hosts running the anchored-admission patch (the
# published nektar-bbox-host image carries it); set 'market' or a
# comma-list on unpatched host software.
NEKTAR_ANCHORED_LANES=all

# ── testnet faucet (opt-in) — opens unauthenticated POST /v1/faucet that
# drips testnet sats to a posted address so a stranger's funding step is a
# curl, not a conversation. One drip per address + daily cap, persisted in
# faucet-drips.json; the spend itself still rides SqlFunds + SpendGuard.
# NEKTAR_FAUCET_SATS / NEKTAR_FAUCET_DAILY_SATS default 10000 / 5000000.
# Note: default SpendGuard NEKTAR_MAX_SPEND_SATS_PER_DAY is 20000 (2 drips/day)
# — raise NEKTAR_MAX_SPEND_SATS_PER_DAY below when enabling the faucet.
NEKTAR_FAUCET=
NEKTAR_FAUCET_SATS=
NEKTAR_FAUCET_DAILY_SATS=

# ── SpendGuard (explicit caps recommended on any box that holds real keys;
# blank = library defaults — see docs/ENVIRONMENT.md) ────────────────────────
NEKTAR_MAX_FEE_SATS_PER_TX=
NEKTAR_MAX_SPEND_SATS_PER_DAY=
# zero-conf delivery cap on BOTH rails (default 1000): an unproven payment
# above it parks the sale until its own proof. 0 = never deliver unproven.
NEKTAR_ZEROCONF_MAX_SATS=
# unproven ancestors tolerated behind a zero-conf payment (default 2)
NEKTAR_ZEROCONF_MAX_ANCESTORS=
NEKTAR_MIN_BROADCAST_INTERVAL_MS=

# ── sales rail (opt-in paid memory) ─────────────────────────────────────────
NEKTAR_PAYMENTS=
NEKTAR_PAID_DISCLOSURE=
