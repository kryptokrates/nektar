# nektar bstore deployment — copy to .env, pick a network, set the secrets.
# BSTORE_NETWORK is the one knob that flips testnet ↔ mainnet.

BSTORE_NETWORK=test

# ── chain endpoints (set once; BSTORE_NETWORK picks the values below) ──────
# testnet:
BSTORE_CHAIN=woc:test
BSTORE_SETTLE=arcade:test
BSTORE_HEADERS=woc:test
BSTORE_TRACKER_URL=https://api.whatsonchain.com/v1/bsv/test
# mainnet — swap the whole block when you flip BSTORE_NETWORK=main:
# BSTORE_CHAIN=woc:main
# BSTORE_SETTLE=arcade:main
# BSTORE_HEADERS=woc:main
# BSTORE_TRACKER_URL=https://api.whatsonchain.com/v1/bsv/main

# ── identities ────────────────────────────────────────────────────────────
# bucket the stack serves — the owner's <name>_<suffix> from `bstore bucket list`
BSTORE_BUCKETS=
BSTORE_OWNER=
BSTORE_ID=

# host payee — where ls_bstore terms payments land (an identity pubkey)
BSTORE_PAYEE_KEY=

# ── S3 gateway ────────────────────────────────────────────────────────────
BSTORE_S3_PORT=9000
BSTORE_S3_KEY=nektar
# REQUIRED — set a real secret; the gateway refuses a default
BSTORE_S3_SECRET=

# ── economics (testnet defaults; size for mainnet) ─────────────────────────
BSTORE_MIN_BOUNTY=1000
BSTORE_RENEW_PER_GIB=250
BSTORE_BOUNTY=3000
BSTORE_RETENTION=86400
DB_PASSWORD=nektar
