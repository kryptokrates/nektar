# ── required ────────────────────────────────────────────────────────────────
# encrypts keys.json at rest — generate: openssl rand -hex 32
NEKTAR_KEY_PASSPHRASE=

# bearer for /mcp + private /v1 endpoints — generate: openssl rand -hex 32
NEKTAR_HTTP_TOKEN=

# overlay internals — generate: openssl rand -hex 32 (both)
OVERLAY_DB_PASSWORD=
OVERLAY_ADMIN_TOKEN=

# your hosts' PUBLIC URLs — the hub's announce and finger record advertise
# these verbatim, so they must be what OTHER operators can reach, e.g.
#   https://hub.example/hosts/a,https://hub.example/hosts/b
# (a reverse proxy maps /hosts/a→:18391, /hosts/b→:18392). Include the seed
# hosts too so your hub reads the whole network, not just its own lanes:
#   ...your-pair...,https://nektar.run/hosts/a,https://nektar.run/hosts/b
NEKTAR_MARKET_HOSTS=

# ── discovery ───────────────────────────────────────────────────────────────
# publish the directory card (default on for a hub — discoverability is the
# point). The card carries your hosts + offered seed packs.
NEKTAR_ANNOUNCE=1
# publish your bfinger record so counterparties resolve your office/push
NEKTAR_BFINGER_PUBLISH=1
# seed packs at boot from announces matching these domains ('*' = all)
NEKTAR_SEED_DOMAINS=
# your public base URL peers POST pushed carriers to: https://hub.example
NEKTAR_PUSH_PUBLIC=
# your watch shims' public URLs (ports 18393/18394 → /watch/a, /watch/b)
NEKTAR_WATCH_URLS=
NEKTAR_WATCH_PUBLIC=

# ── funds & network ─────────────────────────────────────────────────────────
NEKTAR_FUND_WIF=
NEKTAR_NETWORK=testnet
NEKTAR_HTTP_PORT=8080
