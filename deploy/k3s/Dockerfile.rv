# minimal rv image — the overlay node only; no mcp, no stark prover
FROM node:24-slim AS build
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/overlay/package.json packages/overlay/
COPY packages/core/package.json packages/core/
RUN corepack enable && (pnpm install --filter @nektar/overlay... --frozen-lockfile=false || pnpm install --no-frozen-lockfile)
COPY packages/core packages/core
COPY packages/overlay packages/overlay
RUN pnpm --filter @nektar/overlay... build

FROM node:24-slim
WORKDIR /app
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/packages/overlay packages/overlay
COPY --from=build /app/packages/core packages/core
COPY package.json ./
ENV NEKTAR_OVERLAY_HOST=0.0.0.0 NEKTAR_OVERLAY_PORT=8090 NEKTAR_NETWORK=testnet NEKTAR_OVERLAY_DIR=/data
RUN mkdir -p /data && chown node:node /data
USER node
CMD ["node", "packages/overlay/serve.mjs"]
