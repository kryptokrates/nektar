{
  "resource": "market_operations",
  "roots": ["published", "preparing", "watching"],
  "states": [
    "published",
    "collecting",
    "selected",
    "escalated",
    "funding",
    "funding_deferred",
    "funding_failed",
    "awaiting_disclosure",
    "refund_pending",
    "refunding",
    "uncertain",
    "disclosure_verified",
    "preparing",
    "quoted",
    "completing",
    "completion_submitted",
    "watching",
    "seizing",
    "expired",
    "denied",
    "refunded",
    "useful",
    "not_useful",
    "disputed",
    "canceled",
    "declined",
    "preparation_failed",
    "completion_failed",
    "settled",
    "enabled",
    "seized",
    "seize_failed"
  ],
  "terminal": [
    "expired",
    "denied",
    "refunded",
    "useful",
    "not_useful",
    "disputed",
    "canceled",
    "declined",
    "preparation_failed",
    "completion_failed",
    "settled",
    "enabled",
    "funding_failed",
    "seized",
    "seize_failed"
  ],
  "parked": ["disclosure_verified"],
  "nonterminal": [
    "published",
    "collecting",
    "selected",
    "escalated",
    "funding",
    "funding_deferred",
    "awaiting_disclosure",
    "refund_pending",
    "refunding",
    "uncertain",
    "preparing",
    "quoted",
    "completing",
    "completion_submitted",
    "watching",
    "seizing"
  ],
  "notes": {
    "parked": "money settled, awaiting external actor (markUsefulness) — no bound, declared class F4",
    "revival edges": "funding_failed→refund_pending on late escrow-verdict=mined; refunded→uncertain on refund-tx rejection — both proof-gated",
    "tick.error": "label write ONLY — must not refresh the stuck-state clock (F1); modeled as self-transition, effector writes last_error column"
  },
  "transitions": [
    { "state": "published", "event": "want.signed", "intents": ["publish-want"], "target": "collecting" },
    { "state": "published", "event": "stuck.timeout", "guard": "no-escrow", "intents": [], "target": "canceled" },
    { "state": "published", "event": "restored", "intents": [], "target": "awaiting_disclosure" },
    { "state": "collecting", "event": "offers.select", "guard": "policy+budget", "intents": ["record-decision"], "target": "selected" },
    { "state": "collecting", "event": "collect.expired", "intents": [], "target": "expired" },
    { "state": "collecting", "event": "stuck.timeout", "guard": "no-escrow", "intents": [], "target": "expired" },
    { "state": "collecting", "event": "want.republished", "intents": ["republish-want"], "target": "self" },
    { "state": "collecting", "event": "offer.recorded", "intents": ["record-offer"], "target": "self" },
    { "state": "collecting", "event": "offer.rejected", "intents": ["record-offer"], "target": "self" },
    { "state": "selected", "event": "fund.approved", "guard": "policy+approval+cap", "intents": ["reserve-budget"], "target": "funding" },
    { "state": "selected", "event": "cap.refused", "guard": "policy.escalate", "intents": ["request-approval"], "target": "escalated" },
    { "state": "selected", "event": "cap.refused", "guard": "!policy.escalate", "intents": ["release-budget"], "target": "denied" },
    { "state": "selected", "event": "policy.revoked", "intents": [], "target": "denied" },
    { "state": "selected", "event": "policy.denied", "intents": ["release-budget"], "target": "denied" },
    { "state": "selected", "event": "stuck.timeout", "guard": "no-escrow", "intents": ["release-budget"], "target": "canceled" },
    { "state": "escalated", "event": "approval.granted", "intents": [], "target": "funding" },
    { "state": "escalated", "event": "approval.denied", "intents": ["release-budget"], "target": "denied" },
    { "state": "escalated", "event": "approval.expired", "intents": [], "target": "expired" },
    { "state": "escalated", "event": "policy.revoked", "intents": [], "target": "denied" },
    { "state": "funding", "event": "escrow.submitted", "intents": [], "target": "awaiting_disclosure" },
    { "state": "funding", "event": "escrow.resumed", "intents": [], "target": "awaiting_disclosure" },
    { "state": "funding", "event": "escrow.unresolved", "intents": [], "target": "uncertain" },
    { "state": "funding", "event": "escrow.failed", "intents": ["release-budget"], "target": "funding_failed" },
    { "state": "funding", "event": "daily.cap", "intents": [], "target": "funding_deferred" },
    { "state": "funding", "event": "starved.retry", "intents": [], "target": "selected" },
    { "state": "funding", "event": "starved.exhausted", "intents": ["release-budget"], "target": "funding_failed" },
    { "state": "funding", "event": "escrow.prepared", "intents": ["record-prepare"], "target": "self" },
    { "state": "funding", "event": "payment.prepared", "intents": ["record-prepare"], "target": "self" },
    { "state": "funding_deferred", "event": "cap.reset", "intents": [], "target": "selected" },
    { "state": "funding_deferred", "event": "deferred.escrow_aired", "guard": "verified", "intents": [], "target": "awaiting_disclosure" },
    { "state": "funding_deferred", "event": "delivered.parked", "intents": ["park-delivery"], "target": "self" },
    { "state": "funding_deferred", "event": "stuck.timeout", "guard": "maxAgeMs", "intents": ["escalate-human"], "target": "escalated" },
    { "state": "awaiting_disclosure", "event": "disclosure.ok", "guard": "spv-verify", "intents": ["settle"], "target": "disclosure_verified" },
    { "state": "awaiting_disclosure", "event": "disclosure.bad", "intents": ["flag-dispute"], "target": "disputed" },
    { "state": "awaiting_disclosure", "event": "escrow.died", "guard": "verified", "intents": ["refund"], "target": "refunding" },
    { "state": "awaiting_disclosure", "event": "escrow.gone", "guard": "verdict=dead", "intents": [], "target": "funding_failed" },
    { "state": "awaiting_disclosure", "event": "refund.due", "intents": ["refund"], "target": "refunding" },
    { "state": "awaiting_disclosure", "event": "daily.cap", "intents": [], "target": "funding_deferred" },
    { "state": "awaiting_disclosure", "event": "stuck.timeout", "guard": "maxAgeMs", "intents": ["refund"], "target": "refunding" },
    { "state": "awaiting_disclosure", "event": "stuck.timeout", "guard": "no-escrow", "intents": ["release-budget"], "target": "canceled" },
    { "state": "awaiting_disclosure", "event": "stuck.timeout", "guard": "payment-final", "intents": [], "target": "disputed" },
    { "state": "awaiting_disclosure", "event": "delivered.parked", "intents": ["park-delivery"], "target": "self" },
    { "state": "awaiting_disclosure", "event": "decline.received", "intents": ["record-decline"], "target": "self" },
    { "state": "awaiting_disclosure", "event": "restored", "intents": [], "target": "self" },
    { "state": ["funding", "awaiting_disclosure", "refunding"], "event": "needs.human", "guard": "unresolved", "intents": ["request-approval"], "target": "uncertain" },
    {
      "state": ["selected", "funding", "funding_deferred", "refund_pending", "refunding", "completing", "completion_submitted", "watching", "seizing"],
      "event": "needs.human",
      "intents": ["request-approval"],
      "target": "escalated"
    },
    { "state": "disclosure_verified", "event": "marked.useful", "intents": [], "target": "useful" },
    { "state": "disclosure_verified", "event": "marked.not_useful", "intents": [], "target": "not_useful" },
    { "state": "funding_failed", "event": "escrow.landed", "guard": "verdict=mined", "intents": [], "target": "refund_pending" },
    { "state": "refund_pending", "event": "refund.due", "guard": "dueHeight", "intents": [], "target": "refunding" },
    { "state": "refund_pending", "event": "escrow.gone", "guard": "verdict=dead", "intents": [], "target": "funding_failed" },
    { "state": "refund_pending", "event": "stuck.timeout", "guard": "maxAgeMs", "intents": ["escalate-human"], "target": "escalated" },
    { "state": "refunding", "event": "refund.sent", "intents": [], "target": "refunded" },
    { "state": "refunding", "event": "refund.retry", "intents": [], "target": "uncertain" },
    { "state": "refunding", "event": "refund.dead", "guard": "verified", "intents": [], "target": "uncertain" },
    { "state": "refunded", "event": "refund.dead", "guard": "verified", "intents": ["reopen-refund"], "target": "uncertain" },
    { "state": "refunded", "event": "refund.proven", "guard": "proof", "intents": [], "target": "self" },
    { "state": "uncertain", "event": "reconciled.ok", "guard": "verified", "intents": [], "target": "awaiting_disclosure" },
    { "state": "uncertain", "event": "reconciled.dead", "guard": "verified", "intents": ["release-budget", "release-leases"], "target": "funding_failed" },
    { "state": "uncertain", "event": "reconcile.pending", "intents": ["reconcile-ping"], "target": "self" },
    { "state": "uncertain", "event": "refund.retry", "intents": [], "target": "self" },
    { "state": "uncertain", "event": "refund.dead", "guard": "verified", "intents": [], "target": "self" },
    { "state": "uncertain", "event": "refund.sent", "intents": [], "target": "refunded" },
    { "state": "uncertain", "event": "stuck.timeout", "guard": "maxAgeMs", "intents": ["escalate-human"], "target": "escalated" },

    { "state": "preparing", "event": "offer.signed", "intents": [], "target": "quoted" },
    { "state": "preparing", "event": "prep.failed", "intents": [], "target": "preparation_failed" },
    { "state": "preparing", "event": "stuck.timeout", "guard": "no-escrow", "intents": [], "target": "preparation_failed" },
    { "state": "quoted", "event": "escrow.verified", "guard": "spv-verify", "intents": [], "target": "completing" },
    { "state": "quoted", "event": "payment.verified", "guard": "spv-verify", "intents": ["adopt-payment"], "target": "completing" },
    { "state": "quoted", "event": "offer.declined", "intents": [], "target": "declined" },
    { "state": "quoted", "event": "escrow.broadcast_refused", "intents": [], "target": "self" },
    { "state": "quoted", "event": "quote.expired", "intents": [], "target": "expired" },
    { "state": "quoted", "event": "restored", "intents": [], "target": "self" },
    { "state": "quoted", "event": "stuck.timeout", "guard": "maxAgeMs", "intents": ["abort"], "target": "canceled" },
    { "state": "completing", "event": "disclosure.submitted", "intents": [], "target": "completion_submitted" },
    { "state": "completing", "event": "direct.delivery", "intents": ["deliver"], "target": "completion_submitted" },
    { "state": "completing", "event": "escrow.broadcast_refused", "intents": [], "target": "quoted" },
    { "state": "completing", "event": "stuck.timeout", "guard": "maxAgeMs", "intents": ["escalate-human"], "target": "escalated" },
    { "state": "completion_submitted", "event": "settlement.proven", "guard": "proof", "intents": [], "target": "settled" },
    { "state": "completion_submitted", "event": "completion.failed", "intents": [], "target": "completion_failed" },
    { "state": "completion_submitted", "event": "proof.depth", "intents": ["record-proven-height"], "target": "self" },
    { "state": "watching", "event": "escrow.deadline", "guard": "deadline-passed", "intents": [], "target": "seizing" },
    { "state": "watching", "event": "enabled", "intents": [], "target": "enabled" },
    { "state": "enabled", "event": "enabled", "intents": [], "target": "enabled" },
    { "state": "seizing", "event": "seize.ok", "intents": [], "target": "seized" },
    { "state": "seizing", "event": "seize.failed", "intents": [], "target": "seize_failed" },
    { "state": "seizing", "event": "seize.not_yet", "intents": ["backoff"], "target": "watching" },
    { "state": "seizing", "event": "resume.restart", "intents": [], "target": "watching" },

    { "state": "*", "event": "tick.error", "intents": ["last-error-column"], "target": "self" },
    { "state": "*", "event": "quote.attached", "intents": [], "target": "self" },
    { "state": "*", "event": "evidence.stored", "intents": [], "target": "self" },
    { "state": "*", "event": "process.crash", "intents": ["boot-reconcile"], "target": "self" },
    { "state": "*", "event": "kill.switch", "intents": [], "target": "self" },
    { "state": "*", "event": "daily.cap", "intents": [], "target": "self" },
    { "state": "*", "event": "reorg", "intents": ["reverify"], "target": "self" }
  ]
}
