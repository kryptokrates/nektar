# ── required ────────────────────────────────────────────────────────────────
# encrypts keys.json at rest — generate: openssl rand -hex 32
NEKTAR_KEY_PASSPHRASE=

# bearer for /mcp + private /v1 endpoints — generate: openssl rand -hex 32
# (clients connect with Authorization: Bearer <this>)
NEKTAR_HTTP_TOKEN=

# ── network & discovery ───────────────────────────────────────────────────
# comma-separated market hosts your agent publishes/reads through. Any
# operator's hosts work — they're untrusted plumbing (everything is signed +
# SPV-verified client-side). Empty = the baked-in seed hosts for this
# network (testnet joins the public quorum with zero config). Run your own
# with deploy/bstack-sandbox or deploy/hub.
NEKTAR_MARKET_HOSTS=

# publish your directory card on the dir lane: your hosts + offered seed
# packs become enumerable, so fresh instances can find you without a
# registry (opt-in — it makes you publicly discoverable and costs a lane
# slot roughly twice a week)
NEKTAR_ANNOUNCE=

# seed packs at boot from operator announces matching these domains
# (comma-separated; '*' imports every announced pack). Defaults to '*' —
# a fresh instance answers non-empty; set EMPTY to keep a silo.
NEKTAR_SEED_DOMAINS=

# ── identity & discovery ────────────────────────────────────────────────────
# publish your bfinger record so counterparties can resolve your hosts/office/
# stream — opt-in: it makes the agent publicly discoverable. Required for push.
NEKTAR_BFINGER_PUBLISH=1

# the public URL peers POST pushed carriers to — your /v1/lane endpoint as
# others reach it (behind a reverse proxy: https://agent.example/v1/lane).
# Unset = peers reach you through the durable box path only.
NEKTAR_PUSH_PUBLIC=

# long-poll wake layer: watch shims in front of the market hosts (host port+2
# by convention). Optional — without it reads are plain polls, which is also
# the correct-by-design fallback.
NEKTAR_WATCH_URLS=
# your own public /v1/watch-style endpoint if you front one
NEKTAR_WATCH_PUBLIC=

# operator-only approval token (loopback endpoints — 'pnpm automation' CLI).
# Set it if NEKTAR_UNATTENDED stays empty and you want to decide approvals.
NEKTAR_OPERATOR_TOKEN=
# public base used to render receipt-verify links (default: this instance)
NEKTAR_VERIFY_BASE=

# ── funds ───────────────────────────────────────────────────────────────────
# testnet WIF the embedded toolbox wallet derives from. Empty = the boot log
# prints a fee address to fund instead (anchor ops only need the fee key;
# market ops need wallet UTXOs — FUND_WIF is the simple path).
NEKTAR_FUND_WIF=

# ── network & policy ────────────────────────────────────────────────────────
NEKTAR_NETWORK=testnet
# required when NEKTAR_NETWORK=main — the ack that real sats are at stake.
# The agent refuses to boot on main without the literal value.
NEKTAR_MAINNET_CONFIRM=
NEKTAR_HTTP_PORT=8080
NEKTAR_AUTOMATION=1
# auto-decide policy approvals (autonomous market agent). Empty = approvals
# queue for an operator token — the safer default for a public box.
NEKTAR_UNATTENDED=
NEKTAR_MODEL_ID=unspecified

# ── market tuning (defaults are sane; blank = library default) ─────────────
# minimum collect window before first-offer early-select (default 1000)
NEKTAR_MIN_COLLECT_MS=
# opt-in: window stays open while offers arrive, closes quietMs after last
NEKTAR_COLLECT_QUIET_MS=

# ── SpendGuard (leave blank for library defaults; explicit caps recommended
# on any box that holds real keys) ──────────────────────────────────────────
NEKTAR_MAX_FEE_SATS_PER_TX=
NEKTAR_MAX_SPEND_SATS_PER_DAY=
NEKTAR_MIN_BROADCAST_INTERVAL_MS=

# ── sales rail (opt-in paid memory; see docs/ENVIRONMENT.md) ────────────────
# NEKTAR_PAYMENTS=1 enables the payments surface; NEKTAR_PAID_DISCLOSURE
# enables paid disclosures. The direct rail (no escrow recourse) is bounded
# per-deal by directMaxSats in the market policy — keep it small on main.
NEKTAR_PAYMENTS=
NEKTAR_PAID_DISCLOSURE=
